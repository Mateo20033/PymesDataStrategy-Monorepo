# =============================================================================
# PYMES Data Strategy — Variables de Producción
# Copia este archivo como .env.prod y rellena todos los valores
# =============================================================================

# ── Dominio ──────────────────────────────────────────────────────────────────
# Tu dominio público (sin https://)
DOMAIN=pymes.tudominio.com

# URLs públicas (con https://)
NEXTAUTH_URL=https://pymes.tudominio.com
NEXT_PUBLIC_API_URL=https://pymes.tudominio.com
BACKEND_PUBLIC_URL=https://pymes.tudominio.com
MINIO_PUBLIC_ENDPOINT=https://pymes.tudominio.com

# ── PostgreSQL ETL ────────────────────────────────────────────────────────────
POSTGRES_USER=pymes_prod
POSTGRES_PASSWORD=CAMBIA_ESTO_PASSWORD_FUERTE_32CHARS
POSTGRES_DB=pymes_prod

# ── PostgreSQL Analytics ──────────────────────────────────────────────────────
PYMES_DASHBOARD_DB_USER=dashboard_prod
PYMES_DASHBOARD_DB_PASSWORD=CAMBIA_ESTO_DASHBOARD_PASSWORD_32CHARS
PYMES_DASHBOARD_DB_NAME=pymes_dashboard_prod

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CAMBIA_ESTO_REDIS_PASSWORD_32CHARS

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=pymesadmin
MINIO_ROOT_PASSWORD=CAMBIA_ESTO_MINIO_PASSWORD_32CHARS

# ── Auth ──────────────────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
JWT_SECRET=CAMBIA_ESTO_JWT_SECRET
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

NEXTAUTH_SECRET=CAMBIA_ESTO_NEXTAUTH_SECRET
PYMES_DASHBOARD_JWT_SECRET=CAMBIA_ESTO_DASHBOARD_JWT_SECRET
PYMES_DASHBOARD_JWT_EXPIRES_IN=7d

# ── Webhooks internos ─────────────────────────────────────────────────────────
N8N_WEBHOOK_SECRET=CAMBIA_ESTO_N8N_SECRET
N8N_SUGGESTIONS_WEBHOOK_URL=

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=TU_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
