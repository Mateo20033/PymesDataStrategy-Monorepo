# Caddyfile — Reverse proxy + SSL automático
# Reemplaza TU_DOMINIO.COM con tu dominio real (ej: pymes.miempresa.com)
# Caddy obtiene el certificado TLS automáticamente via Let's Encrypt

TU_DOMINIO.COM {
    # Toda la app vive en el frontend (Next.js)
    reverse_proxy frontend:3001

    # Logs de acceso
    log {
        output file /var/log/caddy/access.log
    }

    # Cabeceras de seguridad adicionales
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Robots-Tag "noindex, nofollow"
        -Server
    }
}
